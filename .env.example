# Required only when creating the first account. Set your own password.
DEFAULT_ACCOUNT=admin
DEFAULT_PASSWORD=
# Lowercase default_account/default_password are accepted too.
# SECRET_KEY=use-a-random-value-at-least-32-characters-long
# Default DB: instance/atlas.sqlite beside app.py. Set a URL for PostgreSQL:
# DATABASE_URL=postgresql+psycopg://atlas:your-password@127.0.0.1:5432/atlas
# Set true when serving over HTTPS.
SESSION_COOKIE_SECURE=false

# Direct Redis: works on Windows, macOS, and Linux, without Ansible or SSH.
# SENTINEL_BACKEND=direct
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_NAME=cache
# REDIS_CLUSTER=standalone
# Optional Sentinel alongside the above Redis; REDIS_CLUSTER is its master name:
# SENTINEL_URL=redis://127.0.0.1:26379/0
# Or use a YAML/JSON list for a fleet:
# SENTINEL_TARGETS=/absolute/path/to/targets.yml

# Optional Ansible/server probes, for hardware, storage, and logs:
# SENTINEL_BACKEND=ansible
# SENTINEL_INVENTORY=/absolute/path/to/inventory.yml
# SENTINEL_ANSIBLE_CONFIG=/absolute/path/to/ansible.cfg
# SENTINEL_VAULT_PASSWORD_FILE=/absolute/path/to/vault-password-file
# SENTINEL_ANSIBLE_PLAYBOOK=/absolute/path/to/ansible-playbook
SENTINEL_REDIS_GROUP=redis_nodes
SENTINEL_SENTINEL_GROUP=sentinel_nodes
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=5050
SENTINEL_POLL_INTERVAL=5
SENTINEL_SSH_TIMEOUT=3
SENTINEL_COLLECT_TIMEOUT=20
